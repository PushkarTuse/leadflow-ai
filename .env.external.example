# Copy to .env.external (ignored). These settings affect only the local one-shot runner.
EXTERNAL_LEADS_ENABLED=false
EXTERNAL_LEADS_API_ORIGIN=http://127.0.0.1:8787
EXTERNAL_LEADS_API_TOKEN=dev-token
EXTERNAL_LEADS_SOURCES=hackernews
EXTERNAL_LEADS_BATCH_SIZE=5
# Shadow persists discovery qualification but suppresses discovery notices.
FREELANCE_QUALIFICATION_MODE=shadow
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_DATA_USE_APPROVED=false
# Discovery-only alternative. AI_ENABLED=true and AI_DATA_USE_APPROVED=true are required for OpenAI-compatible use.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
AI_API_BASE_URL=https://api.openai.com/v1
AI_DATA_USE_APPROVED=false
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_OWNER_CHAT_ID=
# Owner-only verification receipt. Never addressed to a discovered lead.
SAFE_OWNER_EMAIL_TEST=true
OWNER_TEST_EMAIL=
OWNER_TEST_EMAIL_FROM=
# Provider-neutral SMTP URL. Credentials are read from stdin, never argv.
# The host, port and TLS mode come entirely from this value; no provider is
# hardcoded in the runner.
#
# Gmail (requires a 16-character App Password with 2-Step Verification enabled;
# an account password will not work):
#   smtps://youraddress@gmail.com:your16charapppassword@smtp.gmail.com:465
#
# Resend (the username is literally "resend"; the password is the API key):
#   smtps://resend:re_your_resend_api_key@smtp.resend.com:465
#
# STARTTLS alternative for either provider:
#   smtp://user:password@host:587
#
# If this value is missing or invalid, the receipt is written to
# outputs/external/email-test-receipt.eml and the status becomes
# SKIPPED_NOT_CONFIGURED. No email is sent.
OWNER_TEST_SMTP_URL=
# No Gmail adapter exists in this runner; Gmail sending is always blocked.
